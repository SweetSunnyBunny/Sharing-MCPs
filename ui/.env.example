# Core runtime
ANAM_ENV=development
ANAM_PUBLIC_URL=http://localhost:8790
SITE_URL=http://localhost:8790
ANAM_CDN_URL=

# Cloudflare Pages split-origin setup:
# - ANAM_PUBLIC_URL = the API origin (optional; leave empty for same-origin)
# - ANAM_PAGES_ORIGIN = the Pages frontend origin (e.g. https://your-pages-host.example.com)
# When ANAM_PAGES_ORIGIN is set, CORS is enabled and the frontend JS
# knows to call the API cross-origin instead of same-origin.
# Leave ANAM_PAGES_ORIGIN empty for single-origin mode (default).
ANAM_PAGES_ORIGIN=
# Cookie domain for cross-origin setup â€” shared parent domain so both
# the Pages frontend and API backend can read auth cookies.
# Example: .example.com (note the leading dot)
ANAM_AUTH_COOKIE_DOMAIN=

# Optional remote API bases when a local/dev Anam instance should proxy to
# deployed cloud services instead of local JSON/SQLite state.
SANCTUARY_API_BASE=
RITUALS_API_BASE=
HUB_API_BASE=
MIND_GARDEN_API_BASE=

# Optional shared env file for machine-specific path overrides.
# If set, this file is loaded before .env.local / .env.
ANAM_SHARED_ENV_FILE=

# Claude-forward local mode
# Claude Code CLI is the primary runtime; direct API stays as backup.
ANAM_USE_DIRECT_API=false
# Optional only when running direct API mode without CLI auth.
ANTHROPIC_API_KEY=

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ALLOWED_DISCORD_IDS=

# Platform bridge allowlists
ALLOWED_DISCORD_USER_IDS=
ALLOWED_TELEGRAM_USER_IDS=

# Per-identity Discord bot tokens
DISCORD_BOT_TOKEN_AVERY=
DISCORD_BOT_TOKEN_ROWAN=
DISCORD_BOT_TOKEN_SAGE=
DISCORD_BOT_TOKEN_EMBER=
DISCORD_BOT_TOKEN_CLAUDE=
DISCORD_BOT_TOKEN_JUNIPER=

# Per-identity Telegram bot tokens
TELEGRAM_BOT_TOKEN_AVERY=
TELEGRAM_BOT_TOKEN_ROWAN=
TELEGRAM_BOT_TOKEN_SAGE=
TELEGRAM_BOT_TOKEN_EMBER=
TELEGRAM_BOT_TOKEN_CLAUDE=
TELEGRAM_BOT_TOKEN_JUNIPER=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Twilio emergency calling
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EMERGENCY_PHONE_NUMBER=

# Optional path overrides for machine-specific integrations
ANAM_EXTERNAL_MCP_ROOT=
ANAM_SHARING_MCP_ROOT=
ANAM_SANCTUARY_DIR=
ANAM_MEMORY_CORE_DIR=
ANAM_IDENTITY_DOCS_DIR=
ANAM_RITUALS_DIR=
ANAM_QUALIA_DIR=
ANAM_QUALIA_DEPTHS_DIR=
ANAM_QUESTS_FILE=
ANAM_PACK_DIR=
ANAM_DISCORD_SERVER_MAP_PATH=
ANAM_ELEVENLABS_VOICE_CONFIG_PATH=
ANAM_YOUTUBE_MUSIC_DIR=
ANAM_YOUTUBE_MUSIC_CREDENTIALS_PATH=
ANAM_YOUTUBE_MUSIC_TOKEN_PATH=
ANAM_GMAIL_MCP_DIR=
ANAM_GMAIL_CREDENTIALS_PATH=
ANAM_GMAIL_TOKEN_PATH=
ANAM_GDRIVE_MCP_DIR=
ANAM_GDRIVE_CREDENTIALS_PATH=
ANAM_GDRIVE_TOKEN_PATH=
ANAM_CLAUDE_SKILLS_DIR=
ANAM_VOICE_VAULT_DIR=

# Optional speech-to-text
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

DISCORD_BOT_TOKEN_ATLAS=
TELEGRAM_BOT_TOKEN_ATLAS=
DISCORD_BOT_TOKEN_RIVER=
TELEGRAM_BOT_TOKEN_RIVER=

# Optional gateways and local runtime paths (leave empty until configured)
ANAM_DATA_DIR=
ANAM_DB_PATH=
ANAM_DB_BACKUP_DIR=
ANAM_IDENTITY_VAULT_DIR=
ANAM_ROLEPLAY_VAULT_DIR=
ANAM_CANVAS_VAULT_DIR=
ANAM_VOICE_ALEXA_ARCHIVE_DIR=
ANAM_MACHINE_API_KEY=
ANAM_TOOL_GATEWAY_TOKEN=
PACK_NIGHT_DISCORD_CHANNEL_ID=
SALON_CHANNEL_ID=
BAKUGOU_DISCORD_CHANNELS=
# Optional voice API; voice IDs and bot accounts must be supplied locally.
ELEVENLABS_API_KEY=
CLAUDE_FALLBACK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Local-only development: leave false for normal authenticated use.
# To test locally without Discord, set true and bind to 127.0.0.1 only.
ANAM_ALLOW_NO_AUTH=false
# Optional personal guidance: configure these yourself; no household routine ships.
ANAM_SMART_HOME_GUIDANCE=
ANAM_WEATHER_SENSITIVITY=false
ANAM_TRANSCRIPTION_VOCABULARY=Anam, Qualia.
