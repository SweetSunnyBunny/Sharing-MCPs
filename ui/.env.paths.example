# Shared machine-specific path overrides for Anam.
# Put real values in one of these locations:
# - %USERPROFILE%\.config\anam\paths.env
# - %USERPROFILE%\.anam-paths.env
# - .env.paths.local in the repo root
# Or point ANAM_SHARED_ENV_FILE at a custom file.

ANAM_EXTERNAL_MCP_ROOT=C:/Apps/mcp
ANAM_SHARING_MCP_ROOT=C:/Apps/mcp\Sharing-MCPs
ANAM_SANCTUARY_DIR=C:/Apps/mcp\sanctuary
ANAM_MEMORY_CORE_DIR=C:/Apps/mcp\memory-core
ANAM_QUALIA_DIR=C:/Apps/mcp\qualia
ANAM_RITUALS_DIR=C:/Apps/mcp\rituals
ANAM_DISCORD_SERVER_MAP_PATH=C:/Apps/mcp\services\discord\config\server_map.json
ANAM_ELEVENLABS_VOICE_CONFIG_PATH=C:/Apps/mcp\sanctuary\voice_config.json
KOKORO_FASTAPI_URL=http://127.0.0.1:8880
KOKORO_FASTAPI_TIMEOUT=300
ANAM_YOUTUBE_MUSIC_DIR=C:/Apps/mcp\youtube-music
ANAM_GMAIL_MCP_DIR=C:/Apps/mcp\Sharing-MCPs\gmail-mcp
ANAM_GDRIVE_MCP_DIR=C:/Apps/mcp\Sharing-MCPs\gdrive-mcp
ANAM_PACK_DIR=C:\Pack
ANAM_CLAUDE_SKILLS_DIR=C:\Users\you\.claude\skills
ANAM_HERMES_SKILLS_DIR=C:\Users\you\AppData\Local\hermes\hermes-agent\skills

# Optional isolated runtime / Vault roots (tests set temporary locations).
# ANAM_DATA_DIR=C:/Apps/anam\data
# ANAM_IDENTITY_VAULT_DIR=C:/Users/YOU\OneDrive\Companion Vault\01_Identities
# ANAM_ROLEPLAY_VAULT_DIR=C:/Users/YOU\OneDrive\Companion Vault\05_Stories\roleplay-conversations
# ANAM_DB_BACKUP_DIR=C:/Users/YOU\OneDrive\Companion Vault\anam-db-backups
# ANAM_DB_BACKUP_KEEP=1
