# Discord Bot Token - needs a bot with voice permissions
DISCORD_BOT_TOKEN=

# Discord Application ID - for slash command registration
DISCORD_APP_ID=

# Guild ID - for guild-specific command registration (faster updates)
DISCORD_GUILD_ID=

# Channel where transcription notes get posted (text channel ID)
NOTES_CHANNEL_ID=

# How often to transcribe chunks (in seconds, default 180 = 3 minutes)
CHUNK_INTERVAL_SECONDS=180

# Claude Code CLI (uses OAuth from ~/.claude/.credentials.json - no API key needed)
# Path to claude CLI if not in PATH (default: claude)
CLAUDE_CMD=claude
# Model for session summaries (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Local Whisper settings
# Model size: tiny, base, small, medium, large-v3 (default: medium)
WHISPER_MODEL=medium
# Device: cpu or cuda (default: cpu)
WHISPER_DEVICE=cpu
# Compute type: int8, float16, float32 (default: int8 for CPU)
WHISPER_COMPUTE_TYPE=int8
# Path to Python executable (default: python)
PYTHON_PATH=python

# Webhook URL for posting notes (optional - uses bot messaging if not set)
NOTES_WEBHOOK_URL=

# Webhook display name and avatar for posted notes
WEBHOOK_DISPLAY_NAME=Scribe
WEBHOOK_AVATAR_URL=
