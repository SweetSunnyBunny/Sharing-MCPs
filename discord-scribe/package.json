{
  "name": "discord-scribe",
  "version": "1.0.0",
  "description": "Discord voice channel recorder with automatic transcription - mod call note-taker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "register": "tsx src/register-commands.ts",
    "install-whisper": "pip install faster-whisper"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.6.1",
    "@discordjs/voice": "^0.18.0",
    "discord-api-types": "^0.38.43",
    "discord.js": "^13.17.1",
    "dotenv": "^16.4.0",
    "prism-media": "^1.3.5",
    "sodium-native": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
