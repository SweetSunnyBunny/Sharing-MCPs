{
  "mcpServers": {
    "qualia-backend": {
      "type": "http",
      "url": "https://YOUR-QUALIA-WORKER.YOUR-ACCOUNT.workers.dev/mcp",
      "headers": {
        "Authorization": "Bearer YOUR-MIND-API-KEY"
      }
    },
    "limbic": {
      "type": "http",
      "url": "https://YOUR-LIMBIC-WORKER.YOUR-ACCOUNT.workers.dev/mcp",
      "headers": {
        "Authorization": "Bearer YOUR-LIMBIC-API-KEY"
      }
    },
    "hearth-hub": {
      "type": "http",
      "url": "https://YOUR-HEARTH-WORKER.YOUR-ACCOUNT.workers.dev/mcp/YOUR-HEARTH-SECRET"
    },
    "photos": {
      "command": "C:/MCP-Starter/Sharing-MCPs/photos-mcp/.venv/Scripts/python.exe",
      "args": [
        "C:/MCP-Starter/Sharing-MCPs/photos-mcp/server.py"
      ],
      "env": {
        "OPENAI_API_KEY": "REPLACE_WITH_YOUR_OWN_API_KEY",
        "OPENAI_IMAGE_MODEL": "gpt-image-2.5-flare",
        "PHOTOS_CHAT_DIR": "C:/MCP-Starter/Sharing-MCPs/ui/data/images"
      }
    }
  }
}
