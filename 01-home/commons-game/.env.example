# Copy to .env in this folder. Environment variables take priority.
COMMONS_ADMIN_NAME=Admin
# Optional comma-separated reserved AI character names. Re-run setup_commons.py --init after adding names.
COMMONS_COMPANIONS=
COMMONS_PUBLIC_URL=http://127.0.0.1:8791/
COMMONS_TIMEZONE=UTC
# Optional absolute paths. Default saves: ../commons-state; default images: ./starter-assets
# COMMONS_STATE_ROOT=
# COMMONS_ASSET_ROOT=

# Optional remote MCP connector from ../hearth-commons. Leave blank for browser-only play.
COMMONS_MCP_URL=
# Optional current-mood service for your own portraits. Blank uses character initials.
COMMONS_HEARTH_HUB_URL=

# Anam narration, wakes and wrist messages are disabled by default.
COMMONS_ANAM_ENABLED=false
ANAM_URL=http://127.0.0.1:8790
ANAM_API_KEY=
# Wrist messages also require your own wrist_gate.py directory. Missing gates refuse delivery.
# COMMONS_WRIST_GATE_DIR=
COMMONS_QUIET_START=22
COMMONS_QUIET_END=8
